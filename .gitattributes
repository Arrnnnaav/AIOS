tests/data/*.json text eol=lf
docs/evidence/**/*.md text eol=lf
docs/evidence/**/*.json text eol=lf
docs/evidence/**/*.jsonl text eol=lf
docs/evidence/**/*.py text eol=lf
ghostcursor/demo/synthetic_export_app.py text eol=lf

# Signed plugin payloads are hashed byte-for-byte into a signed manifest and
# pinned in `bundle.py`. Line endings must therefore be identical everywhere
# the bytes are read: the tracked LF form is canonical, and a Windows working
# copy is normalised to it rather than being allowed to drift into CRLF and
# produce a digest no fresh clone can reproduce (D108).
plugins/**/*.py text eol=lf
plugins/**/*.json text eol=lf
plugins/**/*.md text eol=lf
# The campaign ledger is append-only and byte-compared across history (D155).
docs/campaigns/*.jsonl text eol=lf

# D193: retained plugin-era records, kept byte-exact (their digests are cited).
docs/archive/retained-plugins/** -text
