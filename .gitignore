# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.ruff_cache/
.pytest_cache/
pytest-cache-files-*/

# Local agent/editor settings
.claude/settings.local.json

# User data — the knowledge base lives in %LOCALAPPDATA%, never in the repo,
# but guard against a stray local copy.
*.sqlite
*.sqlite3
kb.sqlite*

# Secrets (search/LLM API keys land here once the KB pipeline exists)
.env
.env.*
!.env.example

# pytest tmp_path scratch when TMPDIR is redirected into the repo
.tmp_pytest/
/.tmp/
/pytest-temp-*/
/pytest-plan-*/
/pytest_tmp/
/tmp*/

# Local diagnostic and generated-analysis output. Sanitized findings belong
# in DECISIONS.md; raw stacks and regenerated graphs stay off the public tree.
/.artifacts/
/graphify-out/

# Local source extracts used during design review; canonical context remains
# in the tracked Word document and repository documentation.
/My_idea.md
/build_doc.txt
/.tmp/
/pytest-temp-*/
/pytest-plan-*/
/pytest_tmp/
/tmp*/

# Local diagnostic and generated-analysis output. Sanitized findings belong
# in DECISIONS.md; raw stacks and regenerated graphs stay off the public tree.
/.artifacts/
/graphify-out/
